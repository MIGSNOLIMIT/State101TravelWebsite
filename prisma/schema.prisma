generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TermsOfService {
  id        Int      @id @default(autoincrement())
  heading   String?
  editorContent String?
  content   String?
  updatedAt DateTime @updatedAt
}

model Accreditation {
  id        Int      @id @default(autoincrement())
  logoUrl   String
  name      String?
  updatedAt DateTime @updatedAt
}

model AboutPage {
  id           Int      @id @default(autoincrement())
  heroImageUrl String?  
  heroDescription String?
  storyContent String?
  updatedAt    DateTime @updatedAt
}

model User {
  id         Int      @id @default(autoincrement())
  name       String?
  email      String   @unique
  password   String
  resetToken String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  role       String   @default("editor")
  loginAttempts Int   @default(0)
  lockUntil     DateTime?
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId Int?
  actorName   String?
  actorEmail  String?
  actorRole   String?
  category    String
  action      String
  status      String   @default("SUCCESS")
  summary     String
  targetType  String?
  targetId    String?
  targetLabel String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model Homepage {
  id                   Int      @id @default(autoincrement())
  heroTitle            String
  heroDesc             String
  heroImages           String[]
  aboutTitle           String?
  aboutDesc            String?
  servicesTitle        String?
  testimonialsTitle    String?
  testimonialsImages   String[]
  testimonialsVideoUrl String?
  updatedAt            DateTime @updatedAt
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  iconUrl     String?
  country     String
  buttonLabel String?
  buttonLink  String?
  updatedAt   DateTime @updatedAt
}

model ServicesPage {
  id           Int      @id @default(autoincrement())
  heroImageUrl String?
  heroTitle    String?
  heroDesc     String?
  sectionTitle String?
  sectionDesc  String?
  requirementsText String?
  applicationAvailableDays String[] @default([])
  applicationVisaTypes Json?
  applicationTimeSlots Json?
  updatedAt    DateTime @updatedAt
}

model WhyChooseCard {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  iconUrl     String?
  color       String?
  updatedAt   DateTime @updatedAt
}

model TopBar {
  id      Int    @id @default(autoincrement())
  address String @default("")
  phone   String @default("")
  email   String @default("")
  hours   String @default("")
}

model Header {
  id          Int    @id @default(autoincrement())
  logoUrl     String @default("")
  websiteName String @default("")
}

model Footer {
  id          Int    @id @default(autoincrement())
  address     String @default("")
  phone       String @default("")
  email       String @default("")
  socialLinks String @default("[]")
  logoUrl     String @default("")
  hours       String @default("")
}

model Media {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  altText     String?
  url         String   @unique
  storagePath String?  @unique
  folder      String?
  type        String
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Application & Chatbot Schema (Phase 1) =====

enum ApplicationStatus {
  NEW
  IN_REVIEW
  SCHEDULED
  APPROVED
  PENDING
}

enum DashboardCalendarNoteTag {
  IMPORTANT
  FOLLOW_UP
  REMINDER
}

model ApplicationEntry {
  id            String             @id @default(cuid())
  fullName      String
  email         String
  phone         String
  address       String
  visaType      String
  age           Int
  availableTime String
  availableDay  String
  status        ApplicationStatus  @default(NEW)
  scheduledAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  files         ApplicationFile[]
  statusHistory ApplicationStatusHistory[]

  @@index([archivedAt])
  @@index([status])
  @@index([scheduledAt])
}

model ApplicationStatusHistory {
  id          String             @id @default(cuid())
  applicationId String
  fromStatus  ApplicationStatus?
  toStatus    ApplicationStatus
  note        String
  scheduledAt DateTime?
  actorUserId Int?
  actorName   String?
  actorEmail  String?
  createdAt   DateTime           @default(now())

  application ApplicationEntry   @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt(sort: Desc)])
  @@index([toStatus, createdAt(sort: Desc)])
}

model ApplicationFile {
  id            String           @id @default(cuid())
  applicationId String
  fileUrl       String
  fileType      String
  createdAt     DateTime         @default(now())

  application   ApplicationEntry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model DashboardCalendarNote {
  id          String   @id @default(cuid())
  noteDate    String   @unique
  note        String
  tag         DashboardCalendarNoteTag @default(REMINDER)
  actorUserId Int?
  actorName   String?
  actorEmail  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  history     DashboardCalendarNoteHistory[]
}

model DashboardCalendarNoteHistory {
  id          String   @id @default(cuid())
  noteId      String
  noteDate    String
  note        String
  tag         DashboardCalendarNoteTag
  actorUserId Int?
  actorName   String?
  actorEmail  String?
  createdAt   DateTime @default(now())

  dashboardCalendarNote DashboardCalendarNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt(sort: Desc)])
  @@index([noteDate, createdAt(sort: Desc)])
}

model KnowledgebaseItem {
  id        String   @id @default(cuid())
  title     String
  category  String
  content   String
  updatedAt DateTime @updatedAt
}

model WebsiteView {
  id        String   @id @default(cuid())
  visitorId String
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([visitorId])
}
